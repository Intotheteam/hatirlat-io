# ── Hatirlat.io Production Environment ────────────────────────────────────────
# Kopyala: cp .env.production .env
# Tüm boş alanları doldur, sonra: docker compose up -d

# ── Domain ────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://hatirlat.io
CORS_ALLOWED_ORIGINS=https://hatirlat.io,https://www.hatirlat.io

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=hatirlat
DB_USERNAME=hatirlat
DB_PASSWORD=GUCLU_BIR_SIFRE_GIR

# ── Security ─────────────────────────────────────────────────────────────────
# Üret: openssl rand -hex 32
JWT_SECRET_KEY=BURAYA_64_KARAKTER_RASTGELE_HEX_GIR
# Tam olarak 32 karakter olmalı (AES-256)
ENCRYPTION_SECRET_KEY=BURAYA_32_KARAKTER_GIZLI_ANAHTAR!

# ── Mail (SMTP) ───────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=senin@gmail.com
MAIL_PASSWORD=GMAIL_UYGULAMA_SIFRESI
MAIL_FROM=noreply@hatirlat.io

# ── İleti Merkezi (TR SMS - toplusmsapi.com) ──────────────────────────────────
ILETIMERKEZI_KEY=
ILETIMERKEZI_HASH=
ILETIMERKEZI_SENDER=HATIRLAT
ILETIMERKEZI_SMS_ENABLED=false
ILETIMERKEZI_IYS=1
ILETIMERKEZI_IYS_LIST=BIREYSEL

# ── Netgsm (TR SMS - yedek) ───────────────────────────────────────────────────
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=HATIRLAT
NETGSM_SMS_ENABLED=false

# ── Twilio (Uluslararası SMS + WhatsApp) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_FROM_WHATSAPP=
TWILIO_SMS_ENABLED=false
TWILIO_WHATSAPP_ENABLED=false
